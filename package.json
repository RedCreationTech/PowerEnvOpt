{
  "name": "hongchuang-power-ai-demo",
  "version": "5.0.0",
  "private": true,
  "description": "电源动环本地验证原型：真实模型辅助、Markdown Wiki 与独立合成评测",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node scripts/check.mjs",
    "check:iso": "node scripts/check-iso.mjs && node scripts/check-iso-dom.mjs && node scripts/check-iso-preview.mjs",
    "test": "npm test --prefix tests && node --test tests/*.test.mjs",
    "test:backend": "node tests/server-test.cjs && node --test tests/*.test.mjs",
    "evaluate": "node evaluation/run.mjs",
    "eval:export": "node evaluation/export.mjs",
    "eval:baseline": "node evaluation/run.mjs --baseline-only",
    "eval:wiki": "node evaluation/wiki-run.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
