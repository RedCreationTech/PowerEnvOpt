{
  "name": "hongchuang-power-ai-demo",
  "version": "5.0.0",
  "private": true,
  "description": "电源动环本地验证原型：真实模型辅助、Markdown Wiki 与独立合成评测",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm test --prefix tests && node --test tests/*.test.mjs",
    "test:backend": "node tests/server-test.cjs && node --test tests/*.test.mjs",
    "evaluate": "node evaluation/run.mjs",
    "eval:export": "node evaluation/export.mjs",
    "eval:baseline": "node evaluation/run.mjs --baseline-only",
    "eval:wiki": "node evaluation/wiki-run.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
